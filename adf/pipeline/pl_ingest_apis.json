{
	"name": "pl_ingest_apis",
	"properties": {
		"activities": [
			{
				"name": "Get API Calls",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "SELECT c.api_call_id, c.source_id, s.source_name, c.call_key,\n       c.base_url, c.relative_url,\n       s.landing_container, c.landing_folder, c.landing_file\nFROM   ctl.ApiCall c\nJOIN   ctl.IngestionSource s ON s.source_id = c.source_id\nWHERE  c.is_active = 1 AND s.is_active = 1 \nORDER  BY c.source_id, c.api_call_id;",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_sql_control",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Loop API Calls",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Get API Calls",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Get API Calls').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Log Start",
							"type": "Lookup",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderStoredProcedureName": "[ctl].[usp_StartRun]",
									"storedProcedureParameters": {
										"adf_pipeline_name": {
											"type": "String",
											"value": {
												"value": "@pipeline().Pipeline",
												"type": "Expression"
											}
										},
										"adf_run_id": {
											"type": "String",
											"value": {
												"value": "@pipeline().RunId",
												"type": "Expression"
											}
										},
										"ceiling": {
											"type": "String",
											"value": null
										},
										"source_name": {
											"type": "String",
											"value": {
												"value": "@item().source_name",
												"type": "Expression"
											}
										}
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "ds_sql_control",
									"type": "DatasetReference"
								}
							}
						},
						{
							"name": "Fetch API",
							"type": "Copy",
							"dependsOn": [
								{
									"activity": "Log Start",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "BinarySource",
									"storeSettings": {
										"type": "HttpReadSettings",
										"requestMethod": "GET",
										"additionalHeaders": "Accept-Encoding: identity",
										"requestTimeout": ""
									},
									"formatSettings": {
										"type": "BinaryReadSettings"
									}
								},
								"sink": {
									"type": "BinarySink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									}
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "ds_http_binary",
									"type": "DatasetReference",
									"parameters": {
										"baseUrl": "@item().base_url",
										"relativeUrl": "@item().relative_url"
									}
								}
							],
							"outputs": [
								{
									"referenceName": "ds_adls_binary",
									"type": "DatasetReference",
									"parameters": {
										"container": "@item().landing_container",
										"folderPath": "@item().landing_folder",
										"fileName": "@item().landing_file"
									}
								}
							]
						},
						{
							"name": "Log Success",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [
								{
									"activity": "Fetch API",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "[ctl].[usp_EndRun]",
								"storedProcedureParameters": {
									"error_message": {
										"value": null,
										"type": "String"
									},
									"files_read": {
										"value": null,
										"type": "Int32"
									},
									"rows_quarantined": {
										"value": null,
										"type": "Int64"
									},
									"rows_read": {
										"value": null,
										"type": "Int64"
									},
									"rows_written": {
										"value": null,
										"type": "Int64"
									},
									"run_id": {
										"value": {
											"value": "@activity('Log Start').output.firstRow.run_id",
											"type": "Expression"
										},
										"type": "Guid"
									},
									"status": {
										"value": "SUCCEEDED",
										"type": "String"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "ls_sql_control",
								"type": "LinkedServiceReference"
							}
						},
						{
							"name": "Log Fetch Failure",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [
								{
									"activity": "Fetch API",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "[ctl].[usp_EndRun]",
								"storedProcedureParameters": {
									"error_message": {
										"value": "@activity('Fetch API').output.errors[0].Message",
										"type": "String"
									},
									"files_read": {
										"value": null,
										"type": "Int32"
									},
									"rows_quarantined": {
										"value": null,
										"type": "Int64"
									},
									"rows_read": {
										"value": null,
										"type": "Int64"
									},
									"rows_written": {
										"value": null,
										"type": "Int64"
									},
									"run_id": {
										"value": "@activity('Log Start').output.firstRow.run_id",
										"type": "Guid"
									},
									"status": {
										"value": null,
										"type": "String"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "ls_sql_control",
								"type": "LinkedServiceReference"
							}
						}
					]
				}
			}
		],
		"annotations": []
	}
}