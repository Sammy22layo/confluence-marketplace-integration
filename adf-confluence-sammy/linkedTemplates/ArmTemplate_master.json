{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-confluence-sammy"
		},
		"ls_sql_control_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_sql_control'"
		},
		"ls_adls_confluence_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stconfluencesa.dfs.core.windows.net/"
		},
		"ls_rest_generic_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "@{linkedService().baseUrl}"
		},
		"ls_sql_control_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-confluence-sammy.database.windows.net"
		},
		"ls_sql_control_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "confluence-control"
		},
		"ls_sql_control_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sammyserver"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-confluence-sammy_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_sql_control_password": {
						"value": "[parameters('ls_sql_control_password')]"
					},
					"ls_adls_confluence_properties_typeProperties_url": {
						"value": "[parameters('ls_adls_confluence_properties_typeProperties_url')]"
					},
					"ls_rest_generic_properties_typeProperties_url": {
						"value": "[parameters('ls_rest_generic_properties_typeProperties_url')]"
					},
					"ls_sql_control_properties_typeProperties_server": {
						"value": "[parameters('ls_sql_control_properties_typeProperties_server')]"
					},
					"ls_sql_control_properties_typeProperties_database": {
						"value": "[parameters('ls_sql_control_properties_typeProperties_database')]"
					},
					"ls_sql_control_properties_typeProperties_userName": {
						"value": "[parameters('ls_sql_control_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}